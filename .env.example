# Merged POS admin — environment. Copy to .env to override defaults.
# The app runs with zero config out of the box (SQLite + dev session secret).

# SQLite database file (Prisma). Default: file:./data/pos.db
DATABASE_URL="file:./data/pos.db"

# Web server
PORT=3100
HOST=0.0.0.0
NODE_ENV=development

# Admin session cookie signing secret.
# REQUIRED in production, min 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
SESSION_TTL_MS=28800000
