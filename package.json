{
  "name": "pos-admin-web",
  "version": "1.0.0",
  "private": true,
  "description": "POS admin — merged single Express app (server-rendered EJS + sync API). Keeps the Android sync contract and financial logic intact.",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "argon2": "0.41.1",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
