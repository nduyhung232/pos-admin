<%- include('partials/header') %>

<h4 class="mb-3"><i class="bi bi-shield-check"></i> Lịch sử thao tác</h4>
<p class="text-muted small">Nhật ký append-only mọi thay đổi giá / nhân viên / mã / thiết bị. Không bao giờ chứa PIN.</p>

<div class="card">
  <div class="card-body p-0 table-responsive">
    <table class="table table-sm mb-0">
      <thead class="table-light"><tr><th>Thời gian</th><th>Người thực hiện</th><th>Hành động</th><th>Đối tượng</th><th>Chi tiết</th></tr></thead>
      <tbody>
        <% logs.forEach(function(l){ %>
        <tr>
          <td><%= new Date(l.atMs).toLocaleString('vi-VN') %></td>
          <td class="small"><%= l.actor %></td>
          <td><span class="badge bg-info text-dark"><%= l.action %></span></td>
          <td><%= l.entityType %> · <span class="small text-muted"><%= l.entityId %></span></td>
          <td class="small text-muted" style="max-width:360px; word-break:break-all"><%= l.detail || '' %></td>
        </tr>
        <% }) %>
        <% if (!logs.length) { %><tr><td colspan="5" class="text-center text-muted">Chưa có bản ghi</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
