        <div class="filter-bar-inner">
          <!-- Search box -->
          <div class="search-box">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="text" id="menuSearchInput" class="search-input" placeholder="Tìm kiếm món chè, đá bào, topping yêu thích..." aria-label="Tìm kiếm món">
            <button type="button" id="searchClearBtn" class="search-clear" aria-label="Xóa tìm kiếm">
              <i class="bi bi-x-circle-fill"></i>
