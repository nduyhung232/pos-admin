          <!-- Category Scrollable Pills -->
          <nav class="category-pills-container" id="categoryTabs" aria-label="Bộ lọc danh mục món">
            <button type="button" class="cat-pill active" data-category="ALL">
              <i class="bi bi-grid-fill me-1"></i> Tất Cả Món (<%= products.length %>)
            </button>
            <button type="button" class="cat-pill" data-category="SIGNATURE">
              ⭐ Món Đặc Sắc
            </button>
            <% categories.forEach(function(cat) { %>
              <button type="button" class="cat-pill" data-category="<%= cat %>">
                <%= cat %>
              </button>
            <% }); %>
          </nav>
        </div>
      </div>

      <!-- Products Grid -->
      <div class="products-grid" id="productsGrid">
        <% products.forEach(function(item) { %>
          <article class="product-card" 
                   data-id="<%= item.id %>"
                   data-name="<%= item.name %>" 
                   data-category="<%= item.category %>" 
                   data-price="<%= item.price %>"
                   data-image="<%= item.image %>"
                   data-badge="<%= item.badge || '' %>"
                   data-desc="<%= item.description %>"
                   data-toppings="<%= (item.toppings || []).join(', ') %>"
                   data-signature="<%= item.isSignature ? 'true' : 'false' %>">
            
            <div class="card-thumb-wrapper">
              <img src="<%= item.image %>" alt="<%= item.name %>" class="card-thumb-img" loading="lazy" width="300" height="225">
              <% if (item.badge) { %>
                <span class="card-badge <%= item.isSignature ? 'signature' : '' %>"><%= item.badge %></span>
              <% } %>
              <span class="card-category-tag"><%= item.category %></span>
            </div>

            <div class="card-content">
              <h3 class="card-title"><%= item.name %></h3>
              <p class="card-desc"><%= item.description %></p>

              <% if (item.toppings && item.toppings.length > 0) { %>
                <div class="card-toppings-preview">
                  <% item.toppings.slice(0, 3).forEach(function(top) { %>
                    <span class="topping-chip"><%= top %></span>
                  <% }); %>
                </div>
              <% } %>

              <div class="card-footer">
                <span class="card-price"><%= item.price.toLocaleString('vi-VN') %>đ</span>
                <button type="button" class="btn-card-order" aria-label="Xem chi tiết <%= item.name %>">
                  <i class="bi bi-plus-lg"></i>
                </button>
              </div>
            </div>
          </article>
        <% }); %>
      </div>

