<%- include('partials/header') %>

<h4 class="mb-3"><i class="bi bi-clock-history"></i> Lịch sử ca</h4>

<div class="card">
  <div class="card-body p-0 table-responsive">
    <table class="table table-sm mb-0 align-middle">
      <thead class="table-light">
        <tr>
          <th>Mở lúc</th><th>Đóng lúc</th><th>Máy</th><th>NV</th>
          <th class="text-end">Quỹ đầu</th><th class="text-end">Đếm thực tế</th>
          <th class="text-end">Dự kiến</th><th class="text-end">Chênh lệch</th>
          <th>Trạng thái</th><th>Bảng kê</th>
        </tr>
      </thead>
      <tbody>
        <% shifts.forEach(function(s){ %>
        <tr>
          <td><%= new Date(s.openedAtMs).toLocaleString('vi-VN') %></td>
          <td><%= s.closedAtMs ? new Date(s.closedAtMs).toLocaleString('vi-VN') : '—' %></td>
          <td><%= s.deviceName %></td>
          <td><%= s.staffName || '—' %></td>
          <td class="text-end"><%= Number(s.openingCash).toLocaleString('vi-VN') %></td>
          <td class="text-end"><%= s.countedCash === null ? '—' : Number(s.countedCash).toLocaleString('vi-VN') %></td>
          <td class="text-end"><%= s.expectedCash === null ? '—' : Number(s.expectedCash).toLocaleString('vi-VN') %></td>
          <td class="text-end <%= (s.cashDifference || 0) < 0 ? 'text-danger' : ((s.cashDifference || 0) > 0 ? 'text-warning' : '') %>">
            <%= s.cashDifference === null ? '—' : Number(s.cashDifference).toLocaleString('vi-VN') %>
          </td>
          <td><span class="badge <%= s.status === 'OPEN' ? 'bg-primary' : 'bg-secondary' %>"><%= s.status %></span></td>
          <td class="small text-muted"><%= s.cashBreakdown || '—' %></td>
        </tr>
        <% }) %>
        <% if (!shifts.length) { %><tr><td colspan="10" class="text-center text-muted">Chưa có ca nào</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
