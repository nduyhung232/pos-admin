<%- include('partials/header') %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h4 class="fw-bold mb-1" style="color:#0f172a">
      <i class="bi bi-clock-history text-primary"></i> Lịch sử ca làm việc
    </h4>
    <p class="text-muted small mb-0">
      Tổng cộng: <strong class="text-dark"><%= shifts.length %> ca gần nhất</strong>
    </p>
  </div>
</div>

<div class="card-table-wrapper">
  <div class="table-responsive">
    <table class="table-modern">
      <thead>
        <tr>
          <th style="min-width: 140px;">Mở lúc</th>
          <th style="min-width: 140px;">Đóng lúc</th>
          <th style="min-width: 120px;">Máy POS</th>
          <th style="min-width: 120px;">Thu ngân</th>
          <th class="text-end" style="min-width: 130px;">Doanh thu ca</th>
          <th class="text-end" style="min-width: 120px;">Tiền mặt</th>
          <th class="text-end" style="min-width: 130px;">Chuyển khoản</th>
          <th class="text-end" style="min-width: 110px;">Quỹ đầu ca</th>
          <th class="text-end" style="min-width: 120px;">Đếm thực tế</th>
          <th class="text-end" style="min-width: 120px;">Dự kiến két</th>
          <th class="text-end" style="min-width: 120px;">Lệch két</th>
          <th class="text-center" style="min-width: 110px;">Trạng thái</th>
          <th style="min-width: 150px;">Bảng kê tiền</th>
        </tr>
      </thead>
      <tbody>
        <% shifts.forEach(function(s){ %>
        <% const openD = new Date(s.openedAtMs); %>
        <% const closeD = s.closedAtMs ? new Date(s.closedAtMs) : null; %>
        <tr>
          <!-- Mở lúc -->
          <td>
            <div class="d-flex flex-column">
              <span class="fw-bold text-dark"><%= openD.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %></span>
              <span class="text-muted small"><%= openD.toLocaleDateString('vi-VN') %></span>
            </div>
          </td>

          <!-- Đóng lúc -->
          <td>
            <% if (closeD) { %>
              <div class="d-flex flex-column">
                <span class="fw-bold text-dark"><%= closeD.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %></span>
                <span class="text-muted small"><%= closeD.toLocaleDateString('vi-VN') %></span>
              </div>
            <% } else { %>
              <span class="badge bg-warning-subtle text-warning-emphasis">Đang mở</span>
            <% } %>
          </td>

          <!-- Máy POS -->
          <td>
            <span class="badge bg-light text-secondary border text-nowrap">
              <i class="bi bi-tablet me-1"></i><%= s.deviceName %>
            </span>
          </td>

          <!-- Nhân viên -->
          <td>
            <span class="fw-semibold text-dark text-nowrap">
              <i class="bi bi-person-circle text-primary me-1"></i><%= s.staffName || '—' %>
            </span>
          </td>

          <!-- Doanh thu ca -->
          <td class="text-end text-nowrap">
            <span class="fw-bold text-dark"><%= Number(s.totalSales).toLocaleString('vi-VN') %> đ</span>
            <small class="text-muted d-block" style="font-size: 11.5px;"><%= s.orderCount %> đơn</small>
          </td>

          <!-- Tiền mặt -->
          <td class="text-end text-nowrap">
            <span class="badge-pay badge-pay-cash"><%= Number(s.cashSales).toLocaleString('vi-VN') %> đ</span>
          </td>

          <!-- Chuyển khoản -->
          <td class="text-end text-nowrap">
            <span class="badge-pay badge-pay-transfer"><%= Number(s.transferSales).toLocaleString('vi-VN') %> đ</span>
          </td>

          <!-- Quỹ đầu ca -->
          <td class="text-end fw-semibold text-nowrap">
            <%= Number(s.openingCash).toLocaleString('vi-VN') %> đ
          </td>

          <!-- Đếm thực tế -->
          <td class="text-end fw-bold text-nowrap">
            <%= s.countedCash === null ? '—' : (Number(s.countedCash).toLocaleString('vi-VN') + ' đ') %>
          </td>

          <!-- Dự kiến két -->
          <td class="text-end text-muted text-nowrap">
            <%= s.expectedCash === null ? '—' : (Number(s.expectedCash).toLocaleString('vi-VN') + ' đ') %>
          </td>

          <!-- Lệch két -->
          <td class="text-end text-nowrap">
            <% if (s.cashDifference === null) { %>
              <span class="text-muted">—</span>
            <% } else if (s.cashDifference === 0) { %>
              <span class="badge bg-success-subtle text-success fw-bold">Khớp 0 đ</span>
            <% } else if (s.cashDifference < 0) { %>
              <span class="badge bg-danger-subtle text-danger fw-bold">
                <%= Number(s.cashDifference).toLocaleString('vi-VN') %> đ (Thiếu)
              </span>
            <% } else { %>
              <span class="badge bg-info-subtle text-info-emphasis fw-bold">
                +<%= Number(s.cashDifference).toLocaleString('vi-VN') %> đ (Thừa)
              </span>
            <% } %>
          </td>

          <!-- Trạng thái -->
          <td class="text-center">
            <span class="status-pill <%= s.status === 'OPEN' ? 'status-paid' : 'badge bg-secondary-subtle text-secondary border' %>">
              <% if (s.status === 'OPEN') { %><span class="dot"></span> ĐANG MỞ<% } else { %>ĐÃ ĐÓNG<% } %>
            </span>
          </td>

          <!-- Bảng kê -->
          <td>
            <span class="small text-muted font-monospace"><%= s.cashBreakdown || '—' %></span>
          </td>
        </tr>
        <% }) %>
        <% if (!shifts.length) { %>
        <tr>
          <td colspan="13" class="text-center text-muted py-5">
            <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary opacity-50"></i>
            Chưa có ca làm việc nào được ghi nhận
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
